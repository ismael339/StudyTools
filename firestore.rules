rules_version = '2';

// StudyTools Cloud Firestore security rules (source of truth for the repo).
// Deploy with: firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Accounts created before this change stored their profile under the email
    // instead of the uid, so both ids are accepted while they are migrated.
    function owns(userId) {
      return signedIn() && (request.auth.uid == userId
        || (request.auth.email != null && request.auth.email == userId));
    }

    function ownsByUid(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Billing fields may only be written by trusted server code (Admin SDK),
    // never by pro-success.html or the browser console.
    function billingUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['plan', 'subscriptionId', 'premiumGift', 'role', 'isAdmin']);
    }

    function noBillingOnCreate() {
      return !request.resource.data.keys().hasAny(['subscriptionId', 'premiumGift', 'role', 'isAdmin'])
        && (!('plan' in request.resource.data) || request.resource.data.plan == 'free');
    }

    match /users/{userId} {
      allow read: if owns(userId);
      allow create: if owns(userId) && noBillingOnCreate();
      allow update: if owns(userId) && billingUnchanged();
      allow delete, list: if false;

      // Saved work for every tool: chats, solved exams, citations, decks.
      match /items/{itemId} {
        allow read, get, list: if ownsByUid(userId);
        allow create, update: if ownsByUid(userId) && request.resource.data.tool is string;
        allow delete: if ownsByUid(userId);
      }

      // Legacy layout written by js/user-storage.js (no longer loaded, kept readable).
      match /{legacy=**} {
        allow read: if owns(userId);
        allow write: if false;
      }
    }

    // Daily counters written by api/chat.js using the caller's own token.
    // The browser may only raise a counter by one, so a used-up quota cannot be
    // reset from the console.
    //
    // Free accounts can watch a rewarded ad (api/reward.js) to top up a few
    // extra requests. The `reward` field holds that bonus and is also written
    // with the caller's token, so THIS RULE is the real cap: reward may only
    // rise by at most REWARD_PER_VIDEO per write and never past REWARD_DAILY_CAP.
    // A client that forges the "video watched" callback still cannot exceed the
    // daily ceiling, so the worst case is bounded (15 + 9 = 24/day), not open.
    match /usage/{usageId} {
      allow read: if signedIn() && usageId.split('_')[0] == request.auth.uid;
      // Normal AI request: count +1, reward untouched.
      allow create: if signedIn() && usageId.split('_')[0] == request.auth.uid
        && request.resource.data.count == 1
        && request.resource.data.get('reward', 0) == 0;
      allow update: if signedIn() && usageId.split('_')[0] == request.auth.uid && (
        // (A) A normal AI request bumps the counter by one; the bonus is frozen.
        (request.resource.data.count == resource.data.count + 1
          && request.resource.data.get('reward', 0) == resource.data.get('reward', 0))
        ||
        // (B) A rewarded-video top-up raises only the bonus, in a bounded step,
        //     and never past the daily cap. Count must not move here.
        (request.resource.data.count == resource.data.count
          && request.resource.data.get('reward', 0) > resource.data.get('reward', 0)
          && request.resource.data.get('reward', 0) <= resource.data.get('reward', 0) + 3
          && request.resource.data.get('reward', 0) <= 9)
      );
      allow delete: if false;
    }

    // Newsletter list. Only the server (api/subscribe.js, Admin SDK) writes
    // here, so no address can be added or removed from the browser.
    match /emails/{emailId} {
      allow read, get, list: if false;
      allow write: if false;
    }

    // Entitlement mirror written by lib/admin.js after PayPal confirms payment.
    match /entitlements/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    // Purchase history, readable by the owner for their own receipts.
    match /subscriptions/{subscriptionId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Log of PayPal webhook deliveries, used to ignore retried events.
    match /paypal_events/{eventId} {
      allow read, write: if false;
    }

    // Study Coach memory. The weak-topic profile and the drill history are what
    // make the coach different from a chatbot, so they live in their own
    // collection, written only by the server with the service account.
    match /coach_profiles/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /coach_events/{eventId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Revision plans. Written by the server from the student's own subjects,
    // exam date and Study Coach history, readable only by its owner.
    match /plans/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Everything else is closed. Public content is served from static pages.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
