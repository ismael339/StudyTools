# StudyTools - Redirects for Google Indexing Fix
# Force HTTPS and www canonical domain

RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://www.studytools.pro/$1 [R=301,L]

# Force www
RewriteCond %{HTTP_HOST} ^studytools\.pro [NC]
RewriteRule ^(.*)$ https://www.studytools.pro/$1 [R=301,L]

# Redirect non-www to www for all pages
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://www.studytools.pro/$1 [R=301,L]

# 10 pages - redirect to www HTTPS canonical versions (kept for explicitness)
RewriteRule ^app\.html$ https://www.studytools.pro/app.html [R=301,L]
RewriteRule ^study-assistant\.html$ https://www.studytools.pro/study-assistant.html [R=301,L]
RewriteRule ^study-schedule\.html$ https://www.studytools.pro/study-schedule.html [R=301,L]
RewriteRule ^citation-generator\.html$ https://www.studytools.pro/citation-generator.html [R=301,L]
RewriteRule ^pomodoro-timer\.html$ https://www.studytools.pro/pomodoro-timer.html [R=301,L]
RewriteRule ^gpa-calculator\.html$ https://www.studytools.pro/gpa-calculator.html [R=301,L]
RewriteRule ^exam-solver\.html$ https://www.studytools.pro/exam-solver.html [R=301,L]
RewriteRule ^grade-calculator\.html$ https://www.studytools.pro/grade-calculator.html [R=301,L]

# Fix 404 pages - redirect to relevant existing pages
RewriteRule ^ai-for-students-2026\.html$ https://www.studytools.pro/ai-homework-helper-without-cheating.html [R=301,L]
RewriteRule ^word-counter\.html$ https://www.studytools.pro/study-assistant.html [R=301,L]

# Favicon redirect
RewriteRule ^favicon\.ico$ https://www.studytools.pro/favicon.ico [R=301,L]

# ============================================
# CONTENT MERGER - 301 redirects (duplicate consolidation)
# Merged ~12 thin/duplicate pages into ~9 strong survivor pages
# ============================================

